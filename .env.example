# ============================================================================
# 说明：本项目不通过 .env 文件读取配置，也没有使用 python-dotenv。
#
#   后端参数      →  backend/config.py（图片大小上限、允许的扩展名、置信度阈值、15 类映射）
#   LLM / RAG 配置 →  knowledge/llm/yaml/api_keys.yaml 与 knowledge/llm/yaml/rag_dashscope.yaml
#
# 下面列出 LLM 模块实际用到的 Key 名称，供改用环境变量注入时参考
# （键名与 api_keys.yaml 中的一致）。留空即可，程序会回落到 yaml 配置。
# ============================================================================

# 阿里云百炼（对话 + 向量化 Embedding，主力模型）
DASHSCOPE_API_KEY=

# 博查 Web Search（联网搜索工具）
BOCHA_API_KEY=

# 魔搭 ModelScope（备用）
MODELSCOPE_API_KEY=

# 商汤 SenseNova（备用）
SENSENOVA_API_KEY=

# ⚠️ 请勿把填好真实 Key 的文件提交到仓库
